# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# (or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_..., the same key under its newer name)

# The public address of the game, used in invite links and magic-link redirects.
# On Vercel previews this can be left unset; the request's own address is used instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (v0.5): Stripe test mode, and the Supabase service-role key the webhook uses.
# Server only: never prefix these with NEXT_PUBLIC_. See docs/SETUP.md, section 2b.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
