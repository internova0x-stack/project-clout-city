# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public address of the game, used in invite links and magic-link redirects.
# On Vercel previews this can be left unset; the request's own address is used instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
