{
  "name": "clout-city",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.ts\"",
    "test:db": "bash scripts/test-db.sh",
    "validate:stories": "node --experimental-strip-types --no-warnings scripts/validate-stories.ts",
    "validate:content": "node --experimental-strip-types --no-warnings scripts/validate-content.ts",
    "avatars:fetch": "NODE_USE_ENV_PROXY=1 node scripts/fetch-avatar-sources.mjs",
    "avatars:build": "node scripts/build-base-avatars.mjs",
    "build:shop-images": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types --no-warnings scripts/build-shop-images.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.115.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "three": "0.180.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "@types/node": "22.18.8",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "@types/web-push": "^3.6.4",
    "typescript": "5.9.3"
  }
}
